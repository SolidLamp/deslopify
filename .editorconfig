root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
max_line_length = 100

[*.{js,ts}]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 4

[*.rst]
indent_style = space
indent_size = 2

[{*.mk, Makefile}]
indent_style = tab
indent_size = 8
tab_width = 8
